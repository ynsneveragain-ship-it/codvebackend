APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Salida de correo. Con MAIL_MAILER=log no se envia nada: el correo de compra
# se escribe entero en storage/logs/laravel.log, que es lo que conviene
# mientras se prueba. Para que llegue de verdad, los valores de Gmail son:
#   MAIL_MAILER=smtp  MAIL_SCHEME=smtp  MAIL_HOST=smtp.gmail.com  MAIL_PORT=587
# con MAIL_USERNAME y MAIL_FROM_ADDRESS iguales a la cuenta de Gmail, y en
# MAIL_PASSWORD una contrasena de aplicacion de 16 caracteres
# (https://myaccount.google.com/apppasswords), no la de la cuenta.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Código Veloz"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Porkbun (verificacion de disponibilidad de dominios)
# Credenciales en https://porkbun.com/account/api
PORKBUN_API_KEY=
PORKBUN_SECRET_API_KEY=

# BNB — Pago QR Simple (cobro del asistente de compra)
# Credenciales que entrega el banco. OJO: la primera vez hay que cambiar la
# contraseña inicial con `php artisan bnb:credenciales` o el banco rechaza
# todo lo demas. La referencia de la API esta en BNB_QR_API.md.
BNB_API_URL=http://test.bnb.com.bo
BNB_ACCOUNT_ID=
BNB_AUTHORIZATION_ID=
# Secreto propio al final de la URL del webhook acordada con el banco:
#   https://<dominio-empresa>/api/bnb/notificacion/<BNB_WEBHOOK_TOKEN>
BNB_WEBHOOK_TOKEN=
